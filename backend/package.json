{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:gas-bundle": "node verify-gas-bundle.mjs",
    "gas:login": "clasp login",
    "gas:status": "clasp show-file-status",
    "gas:push": "npm run build && clasp push",
    "gas:pull": "clasp pull",
    "gas:open": "clasp open-script",
    "gas:deploy": "npm run build && clasp push && clasp create-deployment"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.15",
    "esbuild": "^0.28.2",
    "globals": "^17.14.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
